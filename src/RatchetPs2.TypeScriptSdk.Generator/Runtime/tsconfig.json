{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmitOnError": true,
    "declaration": true,
    "rootDir": ".",
    "outDir": "../bin/runtime"
  },
  "include": ["*.ts"]
}
